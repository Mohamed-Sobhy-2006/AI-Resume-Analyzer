# Copy this file to ".env" (setup.bat does it for you) and fill in your values.
# NEVER commit the real .env file.

# Google Gemini API key (optional - the app works without it using fallback logic).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Gemini model name (optional)
GEMINI_MODEL=gemini-2.5-flash

# Secret used to sign login tokens. Leave blank to auto-generate one in data/.secret_key
SECRET_KEY=

# Maximum resume upload size in megabytes
MAX_UPLOAD_MB=5
